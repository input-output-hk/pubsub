# PubSub node Cardano integration — copy to .env and fill in values
#
# Blockfrost API key
# Get one at https://blockfrost.io (free tier is sufficient for testing)
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Blockfrost base URL (defaults to preprod if omitted in tests)
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0

# Deployed contract addresses — fill in after the bootstrap transaction
# Derive these from plutus.json validator hashes using pallas-addresses or cardano-cli
PUBSUB_NODE_REGISTRY_ADDR=addr_test1...
PUBSUB_TOPIC_REGISTRY_ADDR=addr_test1...
PUBSUB_PUBLISHER_VAULT_ADDR=addr_test1...

# Registry minting policy ID (56 hex chars = 28 bytes)
# This is the hash of the registry_validator script from plutus.json
PUBSUB_REGISTRY_POLICY_ID=

# Optional: Demeter utxorpc endpoint
DEMETER_API_KEY=dmtr_apikey...

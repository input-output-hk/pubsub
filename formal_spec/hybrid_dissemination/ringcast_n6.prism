// RingCast Hybrid Dissemination — PRISM DTMC model
//
// Topology : H(6,2) ring — d-links connect each node to its left and right
//            ring neighbours (deterministic, bidirectional)
// R-links  : each forwarding node picks RF random targets uniformly from
//            the remaining N-1 nodes (re-sampled every round)
// Semantics: forward-once — a node forwards exactly once, in the first
//            round after it receives the message
// Source   : node 0 (holds the message at time 0, never fails)
//
// Parameters
//   RF          : r-link fanout (number of random targets per forwarder)
//   p_fail      : probability that an active non-source node fails to forward
//                 (permanent per node: once it fails it never tries again)
//   MAX_ROUND   : safety bound
//
// Round structure (5 phases per round):
//   Phase 0 — Snapshot      : active_i  = info_i AND NOT done_i
//   Phase 1 — Fail-det.     : each active non-source node independently
//                              fails with prob p_fail (removed from active set,
//                              marked done so it never tries again)
//   Phase 2 — D-links       : propagate info along ring from active nodes
//   Phase 3 — R-links       : each active node picks RF random targets
//   Phase 4 — Commit        : mark active nodes done; advance round counter;
//                              absorb if all informed or no active nodes left
//
// Labels
//   "all_informed"      — all six nodes have received the message
//   "coverage_complete" — phase 4 with all informed (all last-round messages counted)
//   "terminated"        — phase 4 with either full coverage or no active forwarders
//
// Rewards
//   "rounds"    — expected dissemination rounds until termination
//   "messages"  — expected total messages sent (d-link + r-link)
//   "coverage"  — expected number of nodes newly informed during dissemination
//                 (add 1 for the source to get total informed at termination)

dtmc

const int RF;                // r-link fanout
const double p_fail;         // per-forwarding failure probability (non-source nodes)
const int MAX_ROUND = 30;    // safety upper bound on rounds

module Dissemination

  // ------------------------------------------------------------------
  // Per-node state  (N = 6, nodes 0..5)
  // info_i   : has received the message (monotone 0→1)
  // done_i   : has forwarded or permanently failed (monotone 0→1)
  // active_i : forwarding THIS round (set in phase 0, pruned in phase 1)
  // ------------------------------------------------------------------

  info0 : [0..1] init 1;   // node 0 = source
  info1 : [0..1] init 0;
  info2 : [0..1] init 0;
  info3 : [0..1] init 0;
  info4 : [0..1] init 0;
  info5 : [0..1] init 0;

  done0 : [0..1] init 0;
  done1 : [0..1] init 0;
  done2 : [0..1] init 0;
  done3 : [0..1] init 0;
  done4 : [0..1] init 0;
  done5 : [0..1] init 0;

  active0 : [0..1] init 0;
  active1 : [0..1] init 0;
  active2 : [0..1] init 0;
  active3 : [0..1] init 0;
  active4 : [0..1] init 0;
  active5 : [0..1] init 0;

  // ------------------------------------------------------------------
  // Control state
  // ------------------------------------------------------------------

  phase  : [0..4]        init 0;
  turn   : [0..5]        init 0;   // used in phases 1 and 3
  rf_rem : [0..10]       init 0;   // range must be >= RF; reset at phase 2→3
  round  : [0..MAX_ROUND] init 0;

  // ==================================================================
  // Phase 0 — Snapshot
  // Compute which nodes will try to forward this round.
  // ==================================================================

  [] phase=0 ->
      (active0' = info0 * (1-done0)) &
      (active1' = info1 * (1-done1)) &
      (active2' = info2 * (1-done2)) &
      (active3' = info3 * (1-done3)) &
      (active4' = info4 * (1-done4)) &
      (active5' = info5 * (1-done5)) &
      (phase' = 1) & (turn' = 0);

  // ==================================================================
  // Phase 1 — Failure determination  (sequential over turn = 0..5)
  //
  // Node 0 (source) is immune.
  // For each other active node i: fails with probability p_fail.
  //   Failure → active_i = 0, done_i = 1  (never retried)
  //   Success → unchanged
  // Inactive nodes are skipped immediately.
  // ==================================================================

  // turn = 0 : source, always skipped
  [] phase=1 & turn=0 ->
      (turn' = 1);

  // turn = 1
  [] phase=1 & turn=1 & active1=1 ->
      p_fail     : (active1' = 0) & (done1' = 1) & (turn' = 2) +
      (1-p_fail) : (turn' = 2);
  [] phase=1 & turn=1 & active1=0 ->
      (turn' = 2);

  // turn = 2
  [] phase=1 & turn=2 & active2=1 ->
      p_fail     : (active2' = 0) & (done2' = 1) & (turn' = 3) +
      (1-p_fail) : (turn' = 3);
  [] phase=1 & turn=2 & active2=0 ->
      (turn' = 3);

  // turn = 3
  [] phase=1 & turn=3 & active3=1 ->
      p_fail     : (active3' = 0) & (done3' = 1) & (turn' = 4) +
      (1-p_fail) : (turn' = 4);
  [] phase=1 & turn=3 & active3=0 ->
      (turn' = 4);

  // turn = 4
  [] phase=1 & turn=4 & active4=1 ->
      p_fail     : (active4' = 0) & (done4' = 1) & (turn' = 5) +
      (1-p_fail) : (turn' = 5);
  [] phase=1 & turn=4 & active4=0 ->
      (turn' = 5);

  // turn = 5  (last: transition to phase 2)
  [] phase=1 & turn=5 & active5=1 ->
      p_fail     : (active5' = 0) & (done5' = 1) & (phase' = 2) & (turn' = 0) +
      (1-p_fail) : (phase' = 2) & (turn' = 0);
  [] phase=1 & turn=5 & active5=0 ->
      (phase' = 2) & (turn' = 0);

  // ==================================================================
  // Phase 2 — D-links  (deterministic, synchronous)
  // H(6,2) ring: node j receives from ring neighbours (j±1) mod 6.
  // ==================================================================

  [] phase=2 ->
      (info0' = max(info0, max(active5, active1))) &
      (info1' = max(info1, max(active0, active2))) &
      (info2' = max(info2, max(active1, active3))) &
      (info3' = max(info3, max(active2, active4))) &
      (info4' = max(info4, max(active3, active5))) &
      (info5' = max(info5, max(active4, active0))) &
      (phase' = 3) & (turn' = 0) & (rf_rem' = RF);

  // ==================================================================
  // Phase 3 — R-links  (probabilistic, sequential over turn = 0..5)
  // ==================================================================

  // ---- Skip / advance-turn transitions ----

  [] phase=3 & turn=0 & (active0=0 | rf_rem=0) ->
      (turn' = 1) & (rf_rem' = RF);
  [] phase=3 & turn=1 & (active1=0 | rf_rem=0) ->
      (turn' = 2) & (rf_rem' = RF);
  [] phase=3 & turn=2 & (active2=0 | rf_rem=0) ->
      (turn' = 3) & (rf_rem' = RF);
  [] phase=3 & turn=3 & (active3=0 | rf_rem=0) ->
      (turn' = 4) & (rf_rem' = RF);
  [] phase=3 & turn=4 & (active4=0 | rf_rem=0) ->
      (turn' = 5) & (rf_rem' = RF);
  [] phase=3 & turn=5 & (active5=0 | rf_rem=0) ->
      (phase' = 4) & (turn' = 0) & (rf_rem' = RF);

  // ---- Probabilistic r-link choices ----

  // turn=0, node 0 → targets {1,2,3,4,5}
  [] phase=3 & turn=0 & active0=1 & rf_rem>0 ->
      1/5 : (info1' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info2' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info3' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info4' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info5' = 1) & (rf_rem' = rf_rem-1);

  // turn=1, node 1 → targets {0,2,3,4,5}
  [] phase=3 & turn=1 & active1=1 & rf_rem>0 ->
      1/5 : (info0' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info2' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info3' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info4' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info5' = 1) & (rf_rem' = rf_rem-1);

  // turn=2, node 2 → targets {0,1,3,4,5}
  [] phase=3 & turn=2 & active2=1 & rf_rem>0 ->
      1/5 : (info0' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info1' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info3' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info4' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info5' = 1) & (rf_rem' = rf_rem-1);

  // turn=3, node 3 → targets {0,1,2,4,5}
  [] phase=3 & turn=3 & active3=1 & rf_rem>0 ->
      1/5 : (info0' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info1' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info2' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info4' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info5' = 1) & (rf_rem' = rf_rem-1);

  // turn=4, node 4 → targets {0,1,2,3,5}
  [] phase=3 & turn=4 & active4=1 & rf_rem>0 ->
      1/5 : (info0' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info1' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info2' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info3' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info5' = 1) & (rf_rem' = rf_rem-1);

  // turn=5, node 5 → targets {0,1,2,3,4}
  [] phase=3 & turn=5 & active5=1 & rf_rem>0 ->
      1/5 : (info0' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info1' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info2' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info3' = 1) & (rf_rem' = rf_rem-1) +
      1/5 : (info4' = 1) & (rf_rem' = rf_rem-1);

  // ==================================================================
  // Phase 4 — Commit
  // Mark active nodes as done.  Absorb or advance round.
  // ==================================================================

  // Absorbing: full coverage
  [] phase=4 & info0=1 & info1=1 & info2=1 & info3=1 & info4=1 & info5=1 ->
      true;

  // Absorbing: no active forwarders and coverage incomplete
  //   → propagation has stalled due to failures; no further progress possible
  [] phase=4 & !(info0=1 & info1=1 & info2=1 & info3=1 & info4=1 & info5=1) &
               active0=0 & active1=0 & active2=0 & active3=0 & active4=0 & active5=0 ->
      true;

  // Normal: mark done flags, advance round
  [] phase=4 & round < MAX_ROUND &
               !(info0=1 & info1=1 & info2=1 & info3=1 & info4=1 & info5=1) &
               !(active0=0 & active1=0 & active2=0 & active3=0 & active4=0 & active5=0) ->
      (done0' = max(done0, active0)) &
      (done1' = max(done1, active1)) &
      (done2' = max(done2, active2)) &
      (done3' = max(done3, active3)) &
      (done4' = max(done4, active4)) &
      (done5' = max(done5, active5)) &
      (round' = round+1) & (phase' = 0);

endmodule

// ==================================================================
// Labels
// ==================================================================

// First state where all nodes have the message (may be mid-round)
label "all_informed" = info0=1 & info1=1 & info2=1 & info3=1 & info4=1 & info5=1;

// Phase 4 after the completing round: all last-round messages already counted
label "coverage_complete" = phase=4 & info0=1 & info1=1 & info2=1 & info3=1 & info4=1 & info5=1;

// Dissemination has terminated: either full coverage or stuck (no active nodes)
label "terminated" = phase=4 & (
    (info0=1 & info1=1 & info2=1 & info3=1 & info4=1 & info5=1) |
    (active0=0 & active1=0 & active2=0 & active3=0 & active4=0 & active5=0)
);

// ==================================================================
// Rewards
// ==================================================================

// Number of rounds elapsed (counted at start of each round)
rewards "rounds"
  phase=0 : 1;
endrewards

// Total messages sent (d-links + r-links), counted until termination
rewards "messages"
  phase=2 : 2 * (active0 + active1 + active2 + active3 + active4 + active5);
  phase=3 & turn=0 & active0=1 & rf_rem>0 : 1;
  phase=3 & turn=1 & active1=1 & rf_rem>0 : 1;
  phase=3 & turn=2 & active2=1 & rf_rem>0 : 1;
  phase=3 & turn=3 & active3=1 & rf_rem>0 : 1;
  phase=3 & turn=4 & active4=1 & rf_rem>0 : 1;
  phase=3 & turn=5 & active5=1 & rf_rem>0 : 1;
endrewards

// Nodes newly informed by d-links and r-links (source not counted; add 1 for source)
// Expected value at termination = R{"coverage"}=? [F "terminated"] + 1
rewards "coverage"
  // Newly informed via d-links (phase 2): reward = number of uninformed nodes
  // that would be informed by the active ring neighbours this step
  phase=2 :   (1-info0) * max(active5, active1)
            + (1-info1) * max(active0, active2)
            + (1-info2) * max(active1, active3)
            + (1-info3) * max(active2, active4)
            + (1-info4) * max(active3, active5)
            + (1-info5) * max(active4, active0);
  // Newly informed via r-links (phase 3): expected reward per step = fraction uninformed
  phase=3 & turn=0 & active0=1 & rf_rem>0 :
      ((1-info1) + (1-info2) + (1-info3) + (1-info4) + (1-info5)) / 5;
  phase=3 & turn=1 & active1=1 & rf_rem>0 :
      ((1-info0) + (1-info2) + (1-info3) + (1-info4) + (1-info5)) / 5;
  phase=3 & turn=2 & active2=1 & rf_rem>0 :
      ((1-info0) + (1-info1) + (1-info3) + (1-info4) + (1-info5)) / 5;
  phase=3 & turn=3 & active3=1 & rf_rem>0 :
      ((1-info0) + (1-info1) + (1-info2) + (1-info4) + (1-info5)) / 5;
  phase=3 & turn=4 & active4=1 & rf_rem>0 :
      ((1-info0) + (1-info1) + (1-info2) + (1-info3) + (1-info5)) / 5;
  phase=3 & turn=5 & active5=1 & rf_rem>0 :
      ((1-info0) + (1-info1) + (1-info2) + (1-info3) + (1-info4)) / 5;
endrewards
